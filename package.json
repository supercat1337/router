{
    "name": "@supercat1337/router",
    "version": "0.8.0",
    "description": "Synchronous state-relative router for SPA and SSR over a tree of JS objects.",
    "author": "Albert Bazaleev",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/types.d.ts",
            "import": "./dist/router.esm.js"
        },
        "./adapters": {
            "types": "./dist/adapters.d.ts",
            "import": "./dist/adapters.esm.js"
        },
        "./links": {
            "types": "./dist/links.d.ts",
            "import": "./dist/links.esm.js"
        },
        "./guard": {
            "types": "./dist/guard.d.ts",
            "import": "./dist/guard.esm.js"
        },
        "./active-links": {
            "types": "./dist/active-links.d.ts",
            "import": "./dist/active-links.esm.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "import": "./dist/testing.esm.js"
        }
    },
    "types": "dist/types.d.ts",
    "scripts": {
        "test": "npm run typecheck && c8 ava",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "clean": "shx rm -rf ./dist && shx mkdir ./dist",
        "build_esm:router": "rollup ./src/index.js        --file ./dist/router.esm.js        --format es",
        "build_esm:adapters": "rollup ./src/adapters.js     --file ./dist/adapters.esm.js      --format es",
        "build_esm:links": "rollup ./src/links.js        --file ./dist/links.esm.js         --format es",
        "build_esm:guard": "rollup ./src/guard.js        --file ./dist/guard.esm.js         --format es",
        "build_esm:active-links": "rollup ./src/active-links.js --file ./dist/active-links.esm.js  --format es",
        "build_esm:testing": "rollup ./src/testing.js      --file ./dist/testing.esm.js       --format es",
        "build_esm": "npm run build_esm:router && npm run build_esm:adapters && npm run build_esm:links && npm run build_esm:guard && npm run build_esm:active-links && npm run build_esm:testing",
        "build_esm_bundle:router": "esbuild ./src/index.js        --format=esm --bundle --platform=neutral --outfile=./dist/router.esm.bundle.js",
        "build_esm_bundle:adapters": "esbuild ./src/adapters.js     --format=esm --bundle --platform=neutral --outfile=./dist/adapters.esm.bundle.js",
        "build_esm_bundle:links": "esbuild ./src/links.js        --format=esm --bundle --platform=neutral --outfile=./dist/links.esm.bundle.js",
        "build_esm_bundle:guard": "esbuild ./src/guard.js        --format=esm --bundle --platform=neutral --outfile=./dist/guard.esm.bundle.js",
        "build_esm_bundle:active-links": "esbuild ./src/active-links.js --format=esm --bundle --platform=neutral --outfile=./dist/active-links.esm.bundle.js",
        "build_esm_bundle:testing": "esbuild ./src/testing.js      --format=esm --bundle --platform=neutral --outfile=./dist/testing.esm.bundle.js",
        "build_esm_bundle": "npm run build_esm_bundle:router && npm run build_esm_bundle:adapters && npm run build_esm_bundle:links && npm run build_esm_bundle:guard && npm run build_esm_bundle:active-links && npm run build_esm_bundle:testing",
        "gen_types:tsc": "npx tsc --project my.tsconfig.types.json",
        "gen_types:copy": "shx cp src/*.d.ts dist/types-temp/src/",
        "gen_types": "npm run gen_types:tsc && npm run gen_types:copy",
        "bundle_types:router": "api-extractor run --local -c api-extractor.json",
        "bundle_types:adapters": "api-extractor run --local -c api-extractor.adapters.json",
        "bundle_types:links": "api-extractor run --local -c api-extractor.links.json",
        "bundle_types:guard": "api-extractor run --local -c api-extractor.guard.json",
        "bundle_types:active-links": "api-extractor run --local -c api-extractor.active-links.json",
        "bundle_types:testing": "api-extractor run --local -c api-extractor.testing.json",
        "bundle_types": "npm run bundle_types:router && npm run bundle_types:adapters && npm run bundle_types:links && npm run bundle_types:guard && npm run bundle_types:active-links && npm run bundle_types:testing",
        "build": "npm run clean && npm run build_esm && npm run build_esm_bundle && npm run gen_types && npm run bundle_types && shx rm -rf dist/types-temp",
        "lint": "eslint src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "lint:strict": "eslint src/ tests/ --max-warnings=0",
        "check-links": "node scripts/check-links.mjs",
        "check-links:list": "node scripts/check-links.mjs --list",
        "bundle-size": "node scripts/bundle-size.mjs",
        "bundle-size:check": "node scripts/bundle-size.mjs --check",
        "bench": "node bench/index.mjs",
        "preflight": "npm run lint:strict && npm run build && npm run bundle-size:check && npm test && npm run check-links",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "publish-packages": "npm run preflight && changeset publish",
        "prepublishOnly": "npm run preflight"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.10",
        "@microsoft/api-extractor": "^7.59.4",
        "ava": "^8.0.1",
        "c8": "^9.1.0",
        "esbuild": "^0.24.0",
        "eslint-plugin-jsdoc": "^63.3.3",
        "globals": "^17.14.0",
        "markdown-link-check": "^3.15.0",
        "rollup": "^4.60.1",
        "shx": "^0.4.0"
    },
    "keywords": [
        "router",
        "spa",
        "ssr",
        "routing",
        "state-relative"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    },
    "homepage": "https://github.com/supercat1337/router",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/supercat1337/router.git"
    },
    "files": [
        "dist/router.esm.js",
        "dist/router.esm.bundle.js",
        "dist/adapters.esm.js",
        "dist/adapters.esm.bundle.js",
        "dist/links.esm.js",
        "dist/links.esm.bundle.js",
        "dist/guard.esm.js",
        "dist/guard.esm.bundle.js",
        "dist/active-links.esm.js",
        "dist/active-links.esm.bundle.js",
        "dist/testing.esm.js",
        "dist/testing.esm.bundle.js",
        "dist/types.d.ts",
        "dist/adapters.d.ts",
        "dist/links.d.ts",
        "dist/guard.d.ts",
        "dist/active-links.d.ts",
        "dist/testing.d.ts",
        "README.md",
        "LICENSE.txt"
    ],
    "ava": {
        "files": [
            "tests/**/*.test.js"
        ],
        "nodeArguments": [
            "--experimental-vm-modules"
        ],
        "extensions": [
            "js"
        ]
    },
    "dependencies": {
        "@supercat1337/event-emitter": "^3.0.0"
    }
}
